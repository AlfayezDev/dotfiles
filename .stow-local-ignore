# GNU Stow local ignore list. Presence REPLACES stock defaults, so they are
# repeated below. Perl regex on paths relative to package root.

# --- stock defaults ---
CVS
RCS
\.git
\.gitignore
\.hg
\.bzr
\.svn
_darcs
\{arch\}
_CVS
_RCS
_SVN
=BUILD
=CHECKOUT
\.stow-local-ignore

# --- repo metadata: never link into $HOME ---
^/README\.md$
^/setup\.sh$
^/stow\.sh$
^/\.ruff_cache$
^/config$

# --- machine-local: secrets + rebuilt-by-setup.sh ---
# Zed settings become a real file so tokens cannot reach the repository. Tasks
# become a real file so setup.sh can select the platform-specific shell path.
^/\.config/secrets/secrets$
^/\.config/zed/settings\.json$
^/\.config/zed/tasks\.json$

# --- machine-specific shells ---
^/\.config/\.zshrc$
