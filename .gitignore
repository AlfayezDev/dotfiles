# Ignore compiled files
*.o
*.so
*.dll
*.pyc
*.class

# Machine-local secrets: template is tracked, real values never are.
.config/secrets/secrets

# Ignore plugin/package directories
lazy-lock.json
repomix-output.*
.ruff_cache/

# Machine-specific shells: per-machine .zshrc, common bits in .config/zsh/
.config/.zshrc
