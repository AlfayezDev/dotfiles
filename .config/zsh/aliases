# zeditor: `z` = open zed; no arg or dir arg = open as project in new window
z() {
    if [ $# -eq 0 ]; then
        zeditor -n "$PWD"
    elif [ $# -eq 1 ] && [ -d "$1" ]; then
        zeditor -n "$1"
    else
        zeditor "$@"
    fi
}
# zoxide: `cd` = smart cd (frecency jump + normal cd behavior), `cdi` = interactive
if command -v zoxide >/dev/null 2>&1; then
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(zoxide init zsh --cmd cd)"
    else
        eval "$(zoxide init bash --cmd cd)"
    fi
fi
