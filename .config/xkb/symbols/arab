// Programming-friendly Arabic layout
// Based on ara(basic). Restores US programming symbols to their QWERTY
// positions: [ ] { } , . < >
// Displaced Arabic letters (و ز ج د) are moved to slots freed by
// consolidating ئ ؤ ة onto shift of their carrier letters (ي و ه),
// and dropping the ﻻ ligature shortcut (type ل+ا instead).
//
// Simplified spelling convention (user choice, not layout-enforced):
//   أ إ آ  ->  typed as ا
//   لا     ->  typed as ل then ا

default partial alphanumeric_keys
xkb_symbols "basic" {
    include "ara(basic)"
    name[Group1]= "Arabic (programming-friendly)";

    key.type[Group1]="FOUR_LEVEL";

    // Restored US programming symbols on [ ] , .
    // (originally held ج / د / و / ز)
    key <AD11> {[ bracketleft,  braceleft,        Arabic_tcheh,             U200F ]};  // [ {
    key <AD12> {[ bracketright, braceright,       U061C,                    any   ]};  // ] }
    key <AB08> {[ comma,        less,             U066C,                    any   ]};  // , <
    key <AB09> {[ period,       greater,          Arabic_jeh,               any   ]};  // . >

    // Carrier + hamza/teh-marbuta on same physical key
    key <AC03> {[ Arabic_yeh,   Arabic_hamzaonyeh, U067F,                   U2068 ]};  // ي ئ
    key <AD08> {[ Arabic_ha,    Arabic_tehmarbuta, Arabic_heh_doachashmee,  U202C ]};  // ه ة

    // Displaced Arabic letters -> freed slots
    key <AB01> {[ Arabic_zain,  asciitilde,        any,                     any   ]};  // ز (was ئ) — keeps ~ on shift
    key <AB03> {[ Arabic_waw,   Arabic_hamzaonwaw, U06C7,                   U0677 ]};  // و ؤ
    key <AB05> {[ Arabic_jeem,  UFEF5,             any,                     any   ]};  // ج (was ﻻ) — keeps ﻵ on shift
    key <AB07> {[ Arabic_dal,   apostrophe,        any,                     any   ]};  // د (was ة) — keeps ' on shift
};
