  "context_servers": {
    "sentry-mcp": {
      "enabled": true,
      "remote": false,
      "settings": {
        "sentry_access_token": "",
        "sentry_host": "https://mcp.sentry.dev/mcp"
      }
    },
    "kagimcp": {
      "enabled": true,
      "remote": false,
      "settings": {
        "kagi_api_key": "",
        "kagi_summarizer_engine": "cecil",
        "kagi_fastgpt_cache": true,
        "kagi_fastgpt_web_search": true
      }
    }
  },
  "edit_predictions": {
    "open_ai_compatible_api": {
      "api_url": ""
    }
  },
  "proxy": "",
  "use_system_window_tabs": false,
  "bottom_dock_layout": "contained",
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "tab_bar": {
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": true,
    "show": false
  },
  "title_bar": {
    "show_user_picture": false,
    "button_layout": "standard",
    "show_menus": false,
    "show_user_menu": false,
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
    "show_branch_status_icon": false
  },
  "search": {
    "button": true
  },
  "terminal": {
    "button": true
  },
  "status_bar": {
    "experimental.show": false
  },
  "which_key": {
    "enabled": true
  },
  "vim": {
    "show_edit_predictions_in_normal_mode": true,
    "gdefault": true,
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": true
  },
  "code_lens": "on",
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "includeLanguages": {
          "svelte": "html"
        },
        "experimental": {
          "classRegex": [
            "class=\"([^\"]*)\"",
            "class='([^']*)'",
            "class:\\s*([^\\s{]+)",
            "\\{\\s*class:\\s*\"([^\"]*)\"",
            "\\{\\s*class:\\s*'([^']*)'"
          ]
        }
      }
    }
  },
  "languages": {
    "Odin": {
      "word_diff_enabled": true,
      "inlay_hints": {
        "show_other_hints": false,
        "show_background": false,
        "show_parameter_hints": false,
        "enabled": false,
        "show_value_hints": false,
        "show_type_hints": false
      },
      "format_on_save": "on"
    }
  },
  "drag_and_drop_selection": {
    "enabled": false
  },
  "show_whitespaces": "none",
  "seed_search_query_from_cursor": "never",
  "autosave": "on_focus_change",
  "cli_default_open_behavior": "new_window",
  "disable_ai": false,
  "tasks": {
    "enabled": true
  },
  "inlay_hints": {
    "show_background": true
  },
  "toolbar": {
    "agent_review": false,
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": true
  },
  "ui_font_family": "MonoLisa",
  "buffer_font_family": "MonoLisa",
  "project_panel": {
    "button": true,
    "dock": "right",
    "hide_root": true,
    "git_status": false,
    "starts_open": false,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never"
    }
  },
  "outline_panel": {
    "button": false,
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "terminal_init_command": "",
    "play_sound_when_agent_done": "when_hidden",
    "inline_assistant_model": {
      "provider": "Z.ai",
      "model": "glm-5.2",
      "enable_thinking": false
    },
    "default_model": {
      "effort": "medium",
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna",
      "enable_thinking": true
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
    "tool_permissions": {
      "default": "allow"
    }
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    },
    "pi-acp": {
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "mode": "build",
        "model": "zai-coding-plan/glm-5.2"
      },
      "type": "registry"
    }
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "ui_font_size": 24.0,
  "buffer_font_size": 15.0,
  "theme": "Modest Dark"
}
