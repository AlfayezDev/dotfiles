[
  {
    "context": "VimControl && !menu",
    "bindings": {
      "space": null,
      "space q q": "workspace::CloseWindow",
      "space g g": ["task::Spawn", { "task_name": "lazygit" }],
      "space o t": "agent::ToggleFocus",
      "space t": "terminal_panel::ToggleFocus",
      "space e": "project_panel::ToggleFocus",
      "space s f": "file_finder::Toggle",
      "space s g": "pane::DeploySearch",
      "space s d": "diagnostics::Deploy",
      "space S": "pane::DeploySearch",
      "space space": "tab_switcher::Toggle",
      "space f": "editor::Format",
      "space o a": "assistant::InlineAssist",
      "space t h": "editor::ToggleInlayHints",
      "space -": ["task::Spawn", { "task_name": "Oil root", "reveal_target": "center" }]
    }
  },
  {
    "context": "Editor && vim_mode == normal",
    "bindings": {
      "!": ["task::Spawn", { "task_name": "bash: run file" }],
      "g O": "outline::Toggle",
      "ctrl-space": "editor::SelectLargerSyntaxNode",
      "ctrl-backspace": "editor::SelectSmallerSyntaxNode",
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-l": "workspace::ActivatePaneRight",
      "-": ["task::Spawn", { "task_name": "Oil", "reveal_target": "center" }]
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-n": "editor::SelectNext"
    }
  },
  {
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "alt-enter": "editor::ConfirmCompletion"
    }
  },
  {
    "context": "AcpThread > Editor",
    "bindings": {
      "escape": "vim::InsertBefore",
      "ctrl-c": "vim::InsertBefore",
      "ctrl-[": "vim::InsertBefore"
    }
  },
  {
    "context": "ProjectPanel || GitPanel || OutlinePanel || CollaborationPanel || AgentPanel",
    "bindings": {
      "alt-q": "workspace::CloseActiveDock"
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "space": null
    }
  },
  {
    "context": "OutlinePanel && not_editing",
    "bindings": {
      "space": null
    }
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt-q": "workspace::CloseActiveDock"
    }
  }
]
