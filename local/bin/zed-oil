#!/usr/bin/env bash
# Spawned from Zed tasks "Oil" / "Oil root": open oil.nvim on a directory.
# Dir priority: $1 arg, then $ZED_DIRNAME, then $ZED_WORKTREE_ROOT, then .
# Enter on a file opens it back in Zed (see ~/.config/nvim/lua/custom/plugins/oil.lua).
dir="${1:-${ZED_DIRNAME:-${ZED_WORKTREE_ROOT:-.}}}"
[ -d "$dir" ] || dir=.
exec nvim --noplugin -n -i NONE \
  -u "$HOME/.config/nvim/zed-oil.lua" \
  "$dir"
