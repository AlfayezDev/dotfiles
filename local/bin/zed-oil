#!/usr/bin/env bash
# Spawned from Zed task "Oil": open oil.nvim on current file's dir.
# Enter on a file opens it back in Zed (see ~/.config/nvim/lua/custom/plugins/oil.lua).
dir="${ZED_DIRNAME:-.}"
[ -d "$dir" ] || dir="${ZED_WORKTREE_ROOT:-.}"
exec nvim --cmd 'let g:oil_open_in_zed = 1' \
  -c 'autocmd FileType oil nnoremap <buffer><silent> q :qa!<CR>' \
  "$dir"
